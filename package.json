{
  "name": "git-sweep",
  "version": "0.1.0",
  "description": "Delete local git branches that are already merged, safely",
  "type": "module",
  "main": "dist/core.js",
  "types": "dist/core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "git",
    "cli",
    "branches",
    "cleanup"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xacking/git-sweep.git"
  },
  "homepage": "https://github.com/xacking/git-sweep#readme",
  "bugs": {
    "url": "https://github.com/xacking/git-sweep/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.0"
  },
  "bin": {
    "git-sweep": "dist/cli.js"
  }
}
